# --- AI chat ("Ask me anything") ---
OPENAI_API_KEY=
OPENAI_URL=https://api.openai.com/v1
# Optional (defaults to gpt-4o-mini)
OPENAI_MODEL=gpt-4o-mini
# Optional: secret used to sign the chat session cookie (falls back to OPENAI_API_KEY).
# Generate with: openssl rand -hex 32
CHAT_SESSION_SECRET=

# --- Contact form (Resend) ---
RESEND_API_KEY=
TO_EMAIL=

# --- GitHub contribution calendar (optional) ---
# Server-side only. Without it the public contributions API is used. Never prefix with NEXT_PUBLIC_.
GITHUB_TOKEN=

# --- Decap CMS (/admin) ---
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
# Optional (defaults to public_repo; use "repo" for a private repository)
GITHUB_OAUTH_SCOPE=
